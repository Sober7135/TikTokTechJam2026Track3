# Copy each section into that process's service-manager environment. Do not
# source this whole file: the control plane and Codex child must not inherit the
# GitHub token, and the poller must not inherit the worker token.

# Control plane
CONTROL_PLANE_BIND=127.0.0.1:8080
CONTROL_PLANE_STATE=control-plane-state.json
CONTROL_PLANE_ADMIN_TOKEN=replace-with-at-least-16-random-characters
CONTROL_PLANE_WORKER_TOKEN=replace-with-a-different-random-token
CONTROL_PLANE_LEASE_SECONDS=30
CONTROL_PLANE_MAX_ATTEMPTS=2
CONTROL_PLANE_ARTIFACT_ROOT=artifacts
CONTROL_PLANE_ARTIFACT_BASE_URL=http://127.0.0.1:8080

# GitHub poller (separate process on the control-plane host)
GITHUB_TOKEN=github_pat_replace_with_fine_grained_token
GITHUB_REPOSITORY=owner/repository
GITHUB_API_BASE=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_POLL_SECONDS=30
GITHUB_POLLER_STATE=github-poller-state.json
GITHUB_POLLER_ONCE=false
BENCHMARK_VERSION=track3-v1
BENCHMARK_HARDWARE_PROFILE=rtx-4070
BENCHMARK_IMAGE=registry.example/techjam-benchmark@sha256:replace-with-64-hex-digest
# GITHUB_POLLER_OPTIONS_PATH=benchmark-options.json

# Optional Codex analysis (control plane only)
CODEX_ANALYSIS_ENABLED=false
CODEX_COMMAND=codex
CODEX_ANALYSIS_ROOT=analysis-workspaces

# Worker
CONTROL_PLANE_URL=http://127.0.0.1:8080
WORKER_ARTIFACT_BASE_URL=http://127.0.0.1:8080
WORKER_ID=local-4070-1
WORKER_HARDWARE_PROFILE=rtx-4070
WORKER_BENCHMARK_IMAGE=registry.example/techjam-benchmark@sha256:replace-with-64-hex-digest
WORKER_GPU_DEVICE=0
WORKER_POLL_SECONDS=5
WORKER_HEARTBEAT_SECONDS=10
WORKER_JOB_TIMEOUT_SECONDS=3600
WORKER_ALLOW_FILE_SOURCE=false
